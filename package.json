{
  "name": "sql-learning-client",
  "version": "1.0.0",
  "description": "SQL Learning Client - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac"
  },
  "keywords": ["sql", "learning", "electron", "offline"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.example.sql-learning-client",
    "productName": "SQL Learning Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "sql-wasm.js",
      "sql-wasm.wasm",
      "main.js"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    }
  }
}