{
  "name": "sql-learning-client",
  "version": "1.0.0",
  "description": "SQL Learning Client - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac",
    "build:win": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --win",
    "build:all": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --win"
  },
  "keywords": ["sql", "learning", "electron", "offline"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.example.sql-learning-client",
    "productName": "SQL Learning Client",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "index.html",
      "sql-wasm.js",
      "sql-wasm.wasm",
      "main.js"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.educational-games"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SQL Learning Client"
    }
  }
}